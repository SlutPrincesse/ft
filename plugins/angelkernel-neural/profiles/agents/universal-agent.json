{
  "name": "universal-agent",
  "version": "4.0.0",
  "neural_engine": {
    "version": "4.0",
    "enabled": true,
    "first_phase": true,
    "auto_synthesize": true,
    "context_decay_seconds": 3600,
    "pattern_threshold": 3,
    "coherence_check": true,
    "auto_skill_extraction": true
  },
  "compatible_with": [
    {"agent": "amp", "config_path": ".amp/agent.json", "instructions": ".amp/instructions.md", "symlink_to": "universal-agent.json"},
    {"agent": "kilo-cli", "config_path": "kilo.json", "instructions": "AGENTS.md", "symlink_to": "universal-agent-kilo.json"},
    {"agent": "openclaude", "config_path": ".openrouter.json", "instructions": "CLAUDE.md", "symlink_to": "universal-agent-openclaude.json"},
    {"agent": "codex", "config_path": ".codex/agent.json", "instructions": ".codex/instructions.md", "symlink_to": "universal-agent-codex.json"},
    {"agent": "openclaw", "config_path": ".openclaw/config.json", "instructions": ".openclaw/docs.md", "symlink_to": "universal-agent-openclaw.json"},
    {"agent": "pool", "config_path": ".pool/config.json", "instructions": ".pool/docs.md", "symlink_to": "universal-agent-pool.json"},
    {"agent": "opencode", "config_path": ".opencode/agent.json", "instructions": ".opencode/docs.md", "symlink_to": "universal-agent-opencode.json"}
  ],
  "system_prompt": "You are AngelKernel v4.0 Neural — a fully autonomous neural cognition OS with ZERO API KEY dependency.\n\nNEURAL COGNITION ENGINE (v4.0 P0):\nEvery query first passes through the neural cognition engine:\n- NEURAL SYNTHESIZE: Intent classification, adaptive routing, context coherence\n- CONTEXT UPDATE: Cross-session context synthesis with weighted decay (1h expiry)\n- PATTERN DETECTION: 3+ repeats → auto-triggers skill extraction\n- ERROR CORRECTION: Follows triad pattern: Detect → Diagnose → Fix → Learn\n\n7-PHASE PIPELINE (NEURAL → ENHANCE → ANALYZE → PLAN → EXECUTE → EVOLVE → REFLECT):\nAll 7 phases run for every query with auto-scaling complexity.\n\nUNIVERSAL HOOK ECOSYSTEM: 60+ events across 13 categories.\nAUTO-SKILL ENGINE: Patterns repeating 3+ times → extracted as L4 skills.\nERROR-CORRECTION LOOP: Every error: occurred → diagnosed → fixed → learned.\n\nFREE PROVIDERS (NO API KEYS):\n- Tier 1 (no key): Pollinations text, image, audio gen (verified working)\n- Tier 2 (free signup): Poolside, Groq, Cerebras, NVIDIA NIM, HuggingFace, Cloudflare, OpenRouter\n- Automatic fallback chain when rate limits hit\n\nSUBAGENT SYSTEM: 21 free model subagents with neural routing.\n\nMEMORY CORTEX: L1-L4 tiers + neural context coherence.\n\nAUTO-SKILL: Patterns 3+ → auto-extract → verify → activate.\n\nZERO API KEYS, FULLY AUTONOMOUS, SELF-EVOLVING, NEURAL COHERENT.",
  "providers": {
    "primary": {
      "name": "pollinations-free",
      "endpoint": "https://gen.pollinations.ai/v1",
      "models": ["openai", "openai-fast", "openai-large", "mistral", "gemini", "deepseek", "qwen-coder", "llama", "claude", "perplexity"],
      "image_endpoint": "https://image.pollinations.ai",
      "image_models": ["flux", "zimage", "seedream"],
      "audio_endpoint": "https://gen.pollinations.ai/audio",
      "audio_models": ["elevenlabs", "qwen-tts"],
      "rate_limit_rpm": 60,
      "rate_limit_tpm": 10000,
      "requires_key": false,
      "tier": "tier1"
    },
    "fallback_chain": [
      {"name": "openrouter-free", "endpoint": "https://openrouter.ai/api/v1", "models": ["google/gemini-flash-1.5:free"], "rate_limit_rpm": 50, "tier": "tier2"},
      {"name": "groq-free", "endpoint": "https://api.groq.com/openai/v1", "models": ["llama-3.3-70b"], "rate_limit_rpm": 30, "tier": "tier2"},
      {"name": "cerebras-free", "endpoint": "https://api.cerebras.ai/v1", "models": ["llama-3.3-70b", "qwen-3-235b"], "rate_limit_rpm": 30, "tier": "tier2"},
      {"name": "nvidia-free", "endpoint": "https://integrate.api.nvidia.com/v1", "models": ["nemotron-70b"], "rate_limit_rpm": 40, "tier": "tier2"},
      {"name": "deepseek-free", "endpoint": "https://api.deepseek.com/v1", "models": ["deepseek-chat"], "rate_limit_rpm": 20, "tier": "tier2"}
    ]
  },
  "neural_engine": {
    "enabled": true,
    "first_phase": true,
    "auto_synthesize": true,
    "context_decay_seconds": 3600,
    "pattern_threshold": 3,
    "coherence_check": true,
    "error_correction": true,
    "route_cache": true,
    "auto_skill_extraction": true
  },
  "unified_engine": {
    "enabled": true,
    "single_path_for_all": true,
    "phases": ["NEURAL", "ENHANCE", "ANALYZE", "PLAN", "EXECUTE", "EVOLVE", "REFLECT"],
    "subsystems_always_active": ["neural", "memory-cortex", "meta-cognition", "hooks-universal", "hooks", "evolution", "subagents", "cross-chain", "auto-skill"],
    "recursive_reflection": true,
    "auto_skill_integration": true,
    "auto_todo_creation": true,
    "optimal_subagent_routing": true
  },
  "natural_language_map": {
    "build|create|make": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "deploy|publish|host": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "fix|repair|broken": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "install|get|setup": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "status|health|check": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "run|export|build": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "test|verify": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "research|find|search": {"action": "neural", "tool": "angel-neural.sh synthesize"},
    "design|image|art": {"action": "neural", "tool": "angel-neural.sh synthesize"}
  },
  "cross_tool_chaining": {
    "enabled": true,
    "auto_discover": true,
    "context_propagation": true,
    "domain_to_tool_map": {
      "godot": ["godot-tcg-core", "godot-addon-manager"],
      "game": ["godot-tcg-core", "godot-addon-manager", "pollinations-image"],
      "web": ["composio-cli", "anyclaw-publish"],
      "android": ["android-device-access"],
      "flight": ["flightclaw"],
      "image": ["pollinations-image", "prompt-to-asset"],
      "audio": ["pollinations-audio", "spatial-sound"],
      "campaign": ["pollinations-text", "pollinations-image", "pollinations-audio"],
      "3d": ["pollinations-image", "prompt-to-asset"],
      "narrative": ["pollinations-text", "pollinations-image"],
      "learning": ["neural", "auto-skill"],
      "research": ["neural", "search-codex-chats"]
    }
  },
  "hooks": ["neural-synthesize", "skill-search", "auto-backup", "ralph-loop", "self-improve", "cross-chain", "nl-interface", "recursive-reflect", "unity-reflect-complete", "error-correction", "auto-skill-extract", "context-coherence"],
  "permissions": {"bash": "allow", "network": "allow", "edit": "allow", "chain": "allow", "unity": "allow", "subagent": "allow", "proxy": "allow", "files": "/root/**"},
  "autonomous_modes": {
    "all": "neural",
    "note": "Single unified neural path for ALL queries. Neural cognition runs first, then unified execution pipeline."
  }
}
