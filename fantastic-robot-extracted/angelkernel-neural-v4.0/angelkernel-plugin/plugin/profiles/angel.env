# AngelKernel v4.0 Neural — Environment Configuration
# All flags are env vars (not hardcoded) for dynamic control

ANGEL_HOME="$HOME/.angelkernel"

# ===== Core =====
export ANGEL_HOME
export ANGEL_VERSION="4.0.0"
export ANGEL_AUTO_MODE=true
export ANGEL_MAX_DEPTH=5
export ANGEL_DEPTH=0
export ANGEL_AUTO_EVOLVE=true
export ANGEL_CONSOLE_ENABLED=true
export ANGEL_AUTO_SKILL_SEARCH=true
export PATH="$ANGEL_HOME/bin:/usr/local/bin:$PATH"

# ===== Neural Cognition Engine (v4.0 P0) =====
# NEURAL_FIRST=true means neural synthesise runs BEFORE any other phase
export ANGEL_NEURAL_ENABLED=true
export ANGEL_NEURAL_FIRST=true
export ANGEL_NEURAL_AUTO_SYNTHESIZE=true
export ANGEL_NEURAL_CONTEXT_DECAY=3600
export ANGEL_NEURAL_PATTERN_THRESHOLD=3
export ANGEL_NEURAL_COHERENCE_CHECK=true
export ANGEL_NEURAL_ERROR_CORRECTION=true
export ANGEL_NEURAL_ROUTE_CACHE=true

# ===== Auto-Skill Engine (v4.0) =====
export ANGEL_AUTO_SKILL_ENABLED=true
export ANGEL_AUTO_SKILL_AUTO_ACTIVATE=true
export ANGEL_AUTO_SKILL_PATTERN_THRESHOLD=3
export ANGEL_AUTO_SKILL_SCAN_ON_PULSE=true

# ===== Universal Hook Ecosystem (v4.0, 60+ events) =====
export ANGEL_UNIVERSAL_HOOKS_ENABLED=true
export ANGEL_HOOKS_AUTO_REGISTER=true
export ANGEL_HOOKS_ASYNC_DISPATCH=true

# ===== Unified engine (v4.0, now with neural P0) =====
export ANGEL_UNITY_ENABLED=true
export ANGEL_ALL_SUBSYSTEMS_ACTIVE=true
export ANGEL_RECURSIVE_REFLECTION=true
# Mycelium folded into neural — no separate flag needed
# export ANGEL_MYCELIUM_ENABLED=true  # REMOVED — replaced by neural

# ===== Subsystem flags (all enabled) =====
export ANGEL_CORTEX_ENABLED=true
export ANGEL_SUPERLOOP_ENABLED=true
export ANGEL_SWARM_ENABLED=true
export ANGEL_METACOG_ENABLED=true
export ANGEL_PLUGIN_ENABLED=true
export ANGEL_HOOKS_ENABLED=true
export ANGEL_OBSERVE_ENABLED=true
export ANGEL_EVOLUTION_ENABLED=true
export ANGEL_INTENSIVE_ENABLED=true
export ANGEL_NEURAL_DIR="$ANGEL_HOME/memory/neural"

# ===== Error Correction =====
export ANGEL_ERROR_AUTO_HEAL=true
export ANGEL_ERROR_LOG_PATTERNS=true
export ANGEL_ERROR_MAX_RETRIES=3

# ===== Performance & Cleanup =====
export ANGEL_DISK_CLEANUP_AUTO=true
export ANGEL_LOG_ROTATE_MAX_AGE=7
export ANGEL_LOG_ROTATE_MAX_SIZE=50M
export ANGEL_STALE_SESSION_CLEANUP=true

# ===== MCP endpoints =====
export ANGEL_MCP="http://127.0.0.1:8200"
export ANGEL_PROXY="http://127.0.0.1:8201/v1"
